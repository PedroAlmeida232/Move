# Copie para .env.local (ignorado pelo Git). Nunca coloque segredos aqui.
EXPO_PUBLIC_API_URL=http://localhost:8080
# ID do cliente web do Google (Firebase → Authentication → Google → Web SDK configuration).
# Não é segredo, mas fica fora do Git como o resto da configuração local.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
