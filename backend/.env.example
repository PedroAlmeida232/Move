# Copie para .env (ignorado pelo Git) e preencha a senha.
# Carregue com: set -a; source .env; set +a
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=postgres.<ref-do-projeto>
DATABASE_PASSWORD=<senha-do-banco>
PORT=8080
